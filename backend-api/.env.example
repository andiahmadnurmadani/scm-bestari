# lewat endpoint /api/keys (yang memakai tabel api_keys).
# Dibaca via header:  x-api-key: <key>
# Contoh untuk 2 konsumen:
# API_KEYS=sk-contoh_key_a_xx1,sk-contoh_key_b_yy2
